# RIDEEL NestJS Backend - Environment Variables
# Copy this file to .env and fill in your actual values. DO NOT commit .env to git.

# Server Configuration
PORT=4000
NODE_ENV=development

# CORS - Allowed frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (backend environment only - NEVER expose to frontend)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rideel

# JWT Configuration
JWT_SECRET=rideel_nestjs_secret_change_in_production_2026
JWT_EXPIRES_IN=7d

# OTP Provider
# Set to 'development' for console-logged testing, or 'msg91' for production SMS
OTP_PROVIDER=development
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY=300
