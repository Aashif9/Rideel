# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/rideel_db

# Google Maps API Key (Optional: system falls back to interactive simulated map layer if not provided)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Configuration (Optional: system falls back to reactive local database service if not provided)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Razorpay Integration Key (Optional: system runs simulated escrow gateway if not provided)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
