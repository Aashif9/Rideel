PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (Backend environment only)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rideel

# OTP Provider Configuration
# Set to 'development' for free console-logged testing, or 'msg91' for production SMS delivery
OTP_PROVIDER=development

# MSG91 Configuration (Only needed when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_EXPIRY=300

